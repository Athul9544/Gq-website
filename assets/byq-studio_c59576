<!-- SEO/AEO: FAQPage + ItemList JSON-LD on browse/tag/category pages; rel="nofollow ugc" on creator links in detail pages (SCA-153).
     v1.1: FAQ/ItemList attempts retry for ~14s because some grids render after DOMContentLoaded.
     v1.2: link collector traverses shadow roots — home/browse template grids render inside code-island custom elements. -->
<script>
  (function () {
    function txt(e) { return (e.textContent || '').trim().replace(/\s+/g, ' '); }
    function inject(id, obj) {
      if (document.getElementById(id)) return true;
      var s = document.createElement('script');
      s.type = 'application/ld+json';
      s.id = id;
      s.text = JSON.stringify(obj);
      document.head.appendChild(s);
      return true;
    }
    function relFix() {
      // Template detail page: creator-authored rich text links are UGC
      document.querySelectorAll('.w-richtext a').forEach(function (a) {
        var h = a.host;
        if (h && h !== location.host && !/(^|\.)webflow\.com$/i.test(h)) {
          a.rel = 'nofollow ugc noopener noreferrer';
        }
      });
    }
    function faq() {
      if (document.getElementById('wf-faq-jsonld')) return true;
      var faqs = [];
      document.querySelectorAll('.faq-wrapper').forEach(function (w) {
        var q = w.querySelector('.faq-section_title');
        var a = w.querySelector('.faq-content');
        if (q && a && txt(q) && txt(a)) {
          faqs.push({ '@type': 'Question', name: txt(q), acceptedAnswer: { '@type': 'Answer', text: txt(a) } });
        }
      });
      return faqs.length ? inject('wf-faq-jsonld', { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs }) : false;
    }
    function collectLinks() {
      var out = [];
      function walk(root) {
        root.querySelectorAll('a[href*="/html/"]').forEach(function (a) { out.push(a); });
        root.querySelectorAll('*').forEach(function (el) { if (el.shadowRoot) walk(el.shadowRoot); });
      }
      walk(document);
      return out;
    }
    function list() {
      if (document.getElementById('wf-itemlist-jsonld')) return true;
      var seen = {}, items = [];
      collectLinks().forEach(function (l) {
        if (items.length >= 50) return;
        var m = (l.getAttribute('href') || '').match(/(?:\/templates)?\/html\/([a-z0-9-]+)/);
        if (!m) return;
        var u = 'https://webflow.com/templates/html/' + m[1];
        if (seen[u]) return;
        seen[u] = 1;
        items.push({ '@type': 'ListItem', position: items.length + 1, url: u });
      });
      return items.length > 1 ? inject('wf-itemlist-jsonld', { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: items }) : false;
    }
    function run() {
      var p = location.pathname;
      if (/\/html\/[a-z0-9-]+\/?$/.test(p)) { relFix(); return; }
      if (p.indexOf('/dashboard') !== -1) return;
      var tries = 0;
      (function attempt() {
        var f = faq();
        var l = list();
        if ((!f || !l) && ++tries < 8) setTimeout(attempt, 2000);
      })();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script><!-- Set Filter/Sort dropdown with selection carets -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Function to update caret visibility
    function updateCaretVisibility() {
      const dropdownItems = document.querySelectorAll('.filter-sort-dropdown-item');

      dropdownItems.forEach(item => {
        const caret = item.closest('.filter-sort-dropdown-item-wrapper').querySelector('.filter-sort-dropdown-caret');

        if (item.classList.contains('w--current')) {
          caret.style.display = 'block';
        } else {
          caret.style.display = 'none';
        }
      });
    }

    // Run the function initially
    updateCaretVisibility();

    // Add click event listeners to dropdown items
    const dropdownItems = document.querySelectorAll('.filter-sort-dropdown-item');
    dropdownItems.forEach(item => {
      item.addEventListener('click', function() {
        dropdownItems.forEach(i => i.classList.remove('w--current'));
        this.classList.add('w--current');
        updateCaretVisibility();
      });
    });

    // Set initial state for "Newest" if it's the default
    const sortLabel = document.getElementById('sort-label');
    if (sortLabel) {
      const defaultSort = sortLabel.textContent.trim();
      const defaultItem = Array.from(dropdownItems).find(item => item.textContent.trim() === defaultSort);
      if (defaultItem) {
        defaultItem.classList.add('w--current');
        updateCaretVisibility();
      }
    }
  });
</script>

